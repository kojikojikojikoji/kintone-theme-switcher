{
  "name": "kintone-theme-switcher",
  "version": "0.1.0",
  "description": "Applies a dark, dim, light, or OS-following theme to the record screens of a kintone app by injecting a two-layer CSS theme. Runs in the browser with no external requests.",
  "author": "Koji Miyazawa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" && node scripts/lint-css.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "icon": "node scripts/svg-to-png.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "^24.0.0",
    "@kintone/dts-gen": "^8.1.1",
    "@kintone/plugin-packer": "^8.1.1",
    "@playwright/test": "^1.45.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
